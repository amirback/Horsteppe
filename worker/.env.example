# Supabase (Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SCRIPT_MODE:
#   mock — no LLM call, template scenes generated locally. Costs $0.
#          Use this to test the pipeline before you have an Anthropic key.
#   llm  — real script generation via Claude (requires ANTHROPIC_API_KEY below)
SCRIPT_MODE=mock

# Anthropic — script generation (only required when SCRIPT_MODE=llm)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5

# ElevenLabs — voice-over
ELEVENLABS_API_KEY=...
# Multilingual voice (default: "Adam"-style). Pick any voice id from your ElevenLabs account.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Fal.ai — images and (optionally) image-to-video
FAL_KEY=...
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# VIDEO_MODE:
#   kenburns — cheap dev mode: animates the still image with pan/zoom in ffmpeg (costs ~$0)
#   provider — real image-to-video via FAL_VIDEO_MODEL (costs real money per clip!)
VIDEO_MODE=kenburns

# ---- ГЛАВНЫЙ ВЫКЛЮЧАТЕЛЬ ДЕНЕГ ----
# 1 (по умолчанию) — ни одного платного вызова: ни LLM, ни озвучки, ни кадров,
#   ни видео. Конвейер доходит до конца на локальных заглушках и стоит ноль.
#   В этом режиме ключи провайдеров не нужны вообще.
# 0 — платный путь разрешён. Ставить осознанно.
# Пустое значение считается безопасным: опечатка в этом файле не должна
# открывать кошелёк.
MVP_SAFE_MODE=1

# ---- Рендер ----
# Формат кадра по умолчанию, если проект его не задал: 9:16 | 16:9 | 1:1 | 4:5
VIDEO_FORMAT=9:16
# Длительность перехода между сценами в секундах. 0 — жёсткие склейки.
TRANSITION_SEC=0.5
# Вшивать субтитры в видео: 1 или 0
SUBTITLES=1
# Шрифт для субтитров. ОБЯЗАТЕЛЬНО задать на сервере: в облегчённых
# контейнерах системных шрифтов нет, и кириллица превратится в квадраты.
# Положите .ttf в worker/assets/fonts/ и укажите путь, либо поставьте
# в образ пакет fonts-dejavu-core.
SUBTITLE_FONT_FILE=

# Optional: path to a royalty-free background music file (mp3).
# Drop one into worker/assets/music/ and point at it. Empty = no music.
MUSIC_FILE=

# Worker tuning
POLL_INTERVAL_SEC=3
WORKER_ID=
