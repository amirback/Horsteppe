# Настройки сборщика Horsteppe.
#
# Скопируйте этот файл в worker/.env и заполните. Файл .env в репозиторий не
# попадает — так и должно быть.
#
# Разделы «ОБЯЗАТЕЛЬНО» и «ДЕНЬГИ» нужны всем. Всё, что ниже, — тонкая
# настройка: там расставлены рабочие значения, и трогать их не нужно, пока
# не понадобится.


# ============================ ОБЯЗАТЕЛЬНО =============================

# Supabase → Settings → API. Сервисный ключ, не публичный.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# ============================== ДЕНЬГИ ================================

# ГЛАВНЫЙ ВЫКЛЮЧАТЕЛЬ.
#   1 (по умолчанию) — ни одного платного вызова: ни сценария, ни озвучки,
#     ни кадров, ни видео. Конвейер доходит до конца на заглушках и стоит
#     ноль. Ключи провайдеров в этом режиме не нужны вообще.
#   0 — платный путь разрешён. Ставить осознанно.
# Пустое значение считается безопасным: опечатка здесь не должна открывать
# кошелёк.
MVP_SAFE_MODE=1

# Откуда берётся движущаяся картинка.
#   kenburns — движение по фотографии рисует ffmpeg. Стоит ноль.
#   provider — настоящая видео-модель. Стоит денег за каждый клип.
VIDEO_MODE=kenburns


# ========================= СЦЕНАРИЙ (текст) ===========================

#   mock — сцены собираются по шаблону локально, без обращения к модели.
#   llm  — настоящий сценарий. Нужен ключ ниже.
SCRIPT_MODE=mock

# Порядок провайдеров через запятую. Не справился первый — пробуем
# следующего. Пусто = только LLM_PROVIDER.
SCRIPT_PROVIDER=anthropic,openrouter
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Нужен только если у аккаунта несколько рабочих пространств.
ANTHROPIC_WORKSPACE_ID=

# Запасной провайдер сценария.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4


# ============================= ОЗВУЧКА ================================

ELEVENLABS_API_KEY=
# Любой голос из вашего аккаунта. Этот — многоязычный.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Сколько раз повторять при перегрузке. Запасного провайдера у озвучки нет.
ELEVENLABS_ATTEMPTS=3


# ======================== КАДРЫ (картинки) ============================

# Порядок провайдеров через запятую.
#   pollinations — бесплатно, ключ не нужен, отвечает не всегда;
#   together     — бесплатная модель, нужен ключ;
#   fal          — платно, нужен ключ и баланс.
IMAGE_PROVIDER=pollinations,together,fal

POLLINATIONS_MODEL=flux
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell


# ===================== ВИДЕО (кадр → движение) ========================

# Порядок провайдеров через запятую. Работает первый, у кого есть ключ.
#   higgsfield — тот сервис, по которому равняется продукт. Оплата картой.
#   fal        — дешевле за секунду, но минимальный платёж $10.
#   replicate  — счёт по факту в конце месяца, предоплаты нет.
VIDEO_PROVIDER=higgsfield,fal,replicate

# Higgsfield: либо одна строка HF_KEY вида «id:secret», либо пара ниже.
HF_KEY=
HF_API_KEY=
HF_API_SECRET=
# Модель. Пути сверены с их openapi.json: pro — лучшая, standard — дешевле.
HIGGSFIELD_VIDEO_MODEL=kling-video/v2.5-turbo/pro/image-to-video

# Fal и Replicate — запасные.
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=wavespeedai/wan-2.1-i2v-480p
# Дополнительные поля модели Replicate одной строкой JSON. Обычно не нужно.
REPLICATE_VIDEO_INPUT=


# ============================== РЕНДЕР ================================

# Формат кадра по умолчанию, если проект его не задал: 9:16 | 16:9 | 1:1 | 4:5
VIDEO_FORMAT=9:16
# Длительность перехода между сценами в секундах. 0 — жёсткие склейки.
TRANSITION_SEC=0.5
# Вшивать субтитры в видео: 1 или 0.
SUBTITLES=1
# Шрифт субтитров. ОБЯЗАТЕЛЬНО задать на сервере: в облегчённых контейнерах
# системных шрифтов нет, и кириллица превратится в квадраты. Положите .ttf в
# worker/assets/fonts/ и укажите путь, либо поставьте пакет fonts-dejavu-core.
SUBTITLE_FONT_FILE=
# Фоновая музыка (mp3) под голос. Пусто — без музыки.
MUSIC_FILE=
# Своя сборка ffmpeg. Пусто — берётся встроенная.
FFMPEG_PATH=


# ============================= СБОРЩИК ================================

POLL_INTERVAL_SEC=3
WORKER_ID=
# Выйти после стольких секунд работы — между задачами, не посреди сборки.
# 0 — работать бесконечно.
WORKER_MAX_RUNTIME_SEC=0
# Файл замка, не дающий запустить второй сборщик на этой машине.
WORKER_LOCK_FILE=/tmp/horsteppe-worker.lock


# ======================== РАЗБОР КАЧЕСТВА =============================

# 1 — сохранять сырой файл провайдера до монтажа, тело запроса без ключей и
# таблицу «провайдер → готовый ролик» в output/debug_quality/. Подробности —
# в docs/AUDIT_QUALITY.md. Выключено ничего не делает.
HORSTEPPE_QUALITY_DEBUG=0
HORSTEPPE_DEBUG_DIR=


# ===================== ТОНКАЯ НАСТРОЙКА ===============================
# Рабочие значения уже расставлены. Меняйте, только если понимаете зачем.

# Сколько ждать провайдера, в секундах.
FAL_IMAGE_TIMEOUT_SEC=180
FAL_VIDEO_TIMEOUT_SEC=600
POLLINATIONS_TIMEOUT_SEC=120
POLLINATIONS_BACKOFF_SEC=5
TOGETHER_TIMEOUT_SEC=120
HIGGSFIELD_TIMEOUT_SEC=900
HIGGSFIELD_POLL_SEC=5
REPLICATE_TIMEOUT_SEC=900
REPLICATE_POLL_SEC=5

# Длительность клипа: у Kling допустимы 5 и 10 секунд.
HIGGSFIELD_DURATION_SEC=5
# Насколько строго модель держится промпта, 0…1. Их умолчание — 0.5.
# Крутить вверх наугад значит получить деревянное движение.
HIGGSFIELD_CFG_SCALE=0.5
# Чего в кадре быть не должно. Пусто — взять список из кода.
HIGGSFIELD_NEGATIVE_PROMPT=

# Потолок длины промпта кадра.
MAX_IMAGE_PROMPT_CHARS=900

# Цены для учёта затрат, в долларах. Это ОЦЕНКИ: у Higgsfield в API цены нет
# ни в ответе, ни отдельным запросом. Завышенная цена урезает качество —
# потолок бюджета отсекает модели, на которые деньги на самом деле есть.
# Подробности — docs/AUDIT_QUALITY.md, раздел J.
COST_HIGGSFIELD_VIDEO_CLIP=0.35
COST_FAL_VIDEO_CLIP=0.35
COST_REPLICATE_VIDEO_CLIP=0.45
COST_FAL_IMAGE=0.006
COST_TOGETHER_IMAGE=0
COST_ELEVENLABS_1K_CHARS=0.18
COST_ANTHROPIC_INPUT_MTOK=5.0
COST_ANTHROPIC_OUTPUT_MTOK=25.0
COST_OPENROUTER_CALL=0.002
