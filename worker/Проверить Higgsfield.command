#!/bin/bash
# Двойной клик: один настоящий клип Higgsfield — проверка платного пути V1.
#
# Что происходит. Заказывается ОДИН клип 5 секунд из картинки нашего же сайта.
# Сразу после того, как Higgsfield принял задачу, процесс намеренно
# завершается — как при сбое. Второй запуск забирает ту же задачу по её
# номеру, без нового заказа. Так проверяется главное: оплаченный клип не
# теряется и не оплачивается дважды.
#
# Цена: около $0.09 по вашему счёту Higgsfield ($0.35 по нашему учёту).

cd "$(dirname "$0")" || exit 1

echo "════════════════════════════════════════════"
echo "  HORSTEPPE — проверка настоящего видео"
echo "════════════════════════════════════════════"
echo
echo "Будет заказан ОДИН клип Higgsfield (5 секунд)."
echo "Цена: около \$0.09 по вашему счёту (\$0.35 по нашему учёту)."
echo
read -r -p "Заказать? Напишите да и нажмите Enter: " answer
if [ "$answer" != "да" ]; then
  echo "Отменено. Ничего не заказано."
  read -r -p "Нажмите Enter, чтобы закрыть…"
  exit 0
fi

if [ ! -d .venv ]; then
  echo "❌ Нет окружения Python. Сначала один раз запустите «Запустить сборщик.command»."
  read -r -p "Нажмите Enter, чтобы закрыть…"
  exit 1
fi

echo
echo "── Шаг 1: заказ и намеренная остановка после постановки задачи"
ALLOW_PAID_SMOKE_TEST=1 MVP_SAFE_MODE=0 PYTHONUTF8=1 ./.venv/bin/python scripts/smoke_real_video.py --kill-after-accept

echo
echo "── Шаг 2: забираем ту же задачу без нового заказа (может занять несколько минут)"
MVP_SAFE_MODE=0 PYTHONUTF8=1 ./.venv/bin/python scripts/smoke_real_video.py --resume
status=$?

echo
if [ $status -eq 0 ]; then
  echo "✓ Готово. Открываю ролик."
  open output/smoke/real_video_test.mp4 2>/dev/null
else
  echo "✗ Проверка не прошла — текст выше объясняет почему. Покажите его агенту."
fi
echo
read -r -p "Нажмите Enter, чтобы закрыть…"
