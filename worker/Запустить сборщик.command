#!/bin/bash
# Двойной клик по этому файлу запускает сборщик видео Horsteppe.
#
# Зачем он нужен. Бесплатный генератор кадров отдаёт ошибку серверам GitHub,
# но нормально работает с домашнего интернета. Пока баланс провайдера не
# пополнен, ролики собираются здесь — на этом компьютере.
#
# Чтобы остановить: закрыть это окно или нажать Ctrl+C.

cd "$(dirname "$0")" || exit 1

echo "════════════════════════════════════════════"
echo "  HORSTEPPE — сборщик видео"
echo "════════════════════════════════════════════"
echo

if [ ! -f .env ]; then
  echo "❌ Нет файла worker/.env с настройками."
  echo "   Без него сборщик не знает, куда подключаться."
  echo
  read -r -p "Нажмите Enter, чтобы закрыть…"
  exit 1
fi

if [ ! -d .venv ]; then
  echo "Первый запуск: устанавливаю всё необходимое."
  echo "Это займёт пару минут и делается только один раз."
  echo
  python3 -m venv .venv || { echo "❌ Не удалось создать окружение Python."; read -r -p "Enter…"; exit 1; }
  ./.venv/bin/pip install -q -r requirements.txt || { echo "❌ Не удалось установить зависимости."; read -r -p "Enter…"; exit 1; }
  echo "✓ Готово."
  echo
fi

echo "Сборщик работает. Окно закрывать нельзя — иначе видео перестанут собираться."
echo "Открывайте сайт и создавайте ролики: https://horsteppe.vercel.app"
echo
echo "────────────────────────────────────────────"
echo

./.venv/bin/python main.py

echo
echo "Сборщик остановлен."
read -r -p "Нажмите Enter, чтобы закрыть…"
